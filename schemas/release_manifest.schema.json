{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kyron.public.release.manifest.v1",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "artifact",
    "sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "kyron.public.release.manifest.v1"
    },
    "version": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
